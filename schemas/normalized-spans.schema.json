{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic normalized server-span dataset v1",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "spans"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "description": {
      "type": "string"
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "trace_id",
          "span_id",
          "service",
          "parent_span_id",
          "kind",
          "start_time_ms",
          "duration_ms",
          "status",
          "phase"
        ],
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "span_id": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "parent_span_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "kind": {
            "const": "SERVER"
          },
          "start_time_ms": {
            "type": "number",
            "minimum": 0
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "enum": [
              "OK",
              "ERROR"
            ]
          },
          "phase": {
            "enum": [
              "healthy",
              "fault",
              "recovery"
            ]
          }
        }
      }
    }
  }
}
