{
  "extensions": {"health_check": {"endpoint": "0.0.0.0:13133"}},
  "receivers": {"otlp": {"protocols": {"grpc": {"endpoint": "0.0.0.0:4317"}, "http": {"endpoint": "0.0.0.0:4318"}}}},
  "processors": {
    "memory_limiter": {"check_interval": "1s", "limit_mib": 170, "spike_limit_mib": 35},
    "batch": {"timeout": "1s", "send_batch_size": 256},
    "filter/server": {"error_mode": "propagate", "traces": {"span": ["kind != SPAN_KIND_SERVER", "IsMatch(name, \"grpc[.]health[.]v1[.]Health/\")"]}}
  },
  "connectors": {"spanmetrics": {
    "namespace": "cct", "metrics_flush_interval": "5s",
    "histogram": {"unit": "ms", "explicit": {"buckets": ["1ms","5ms","10ms","25ms","50ms","100ms","250ms","1s","5s"]}},
    "resource_metrics_key_attributes": ["service.name"],
    "exclude_dimensions": ["span.name"]
  }},
  "exporters": {
    "otlp/jaeger": {"endpoint": "cct-jaeger:4317", "tls": {"insecure": true}},
    "prometheus": {"endpoint": "0.0.0.0:8889"},
    "file/selected": {"path": "/data/selected-logs.jsonl", "rotation": {"max_megabytes": 4, "max_backups": 3, "max_days": 1}, "flush_interval": "1s"}
  },
  "service": {
    "extensions": ["health_check"],
    "telemetry": {"metrics": {"readers": [{"pull": {"exporter": {"prometheus": {"host": "0.0.0.0", "port": 8888}}}}]}},
    "pipelines": {
      "traces": {"receivers": ["otlp"], "processors": ["memory_limiter","batch"], "exporters": ["otlp/jaeger"]},
      "traces/server": {"receivers": ["otlp"], "processors": ["memory_limiter","filter/server"], "exporters": ["spanmetrics"]},
      "metrics": {"receivers": ["otlp","spanmetrics"], "processors": ["memory_limiter","batch"], "exporters": ["prometheus"]},
      "logs": {"receivers": ["otlp"], "processors": ["memory_limiter","batch"], "exporters": ["file/selected"]}
    }
  }
}
