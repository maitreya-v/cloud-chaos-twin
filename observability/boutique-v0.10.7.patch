index 136d303..48e2db7 100644
--- a/src/cartservice/src/Startup.cs
+++ b/src/cartservice/src/Startup.cs
@@ -1,4 +1,6 @@
 using System;
+using OpenTelemetry.Resources;
+using OpenTelemetry.Trace;
 using Microsoft.AspNetCore.Builder;
 using Microsoft.AspNetCore.Diagnostics.HealthChecks;
 using Microsoft.AspNetCore.Hosting;
@@ -56,6 +58,14 @@ namespace cartservice
             }
 
 
+            if (Configuration["ENABLE_TRACING"] == "1")
+            {
+                services.AddOpenTelemetry()
+                    .ConfigureResource(resource => resource.AddService("cartservice"))
+                    .WithTracing(tracing => tracing
+                        .AddAspNetCoreInstrumentation()
+                        .AddOtlpExporter());
+            }
             services.AddGrpc();
         }
 
